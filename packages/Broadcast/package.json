{
  "name": "@ezuikit/control-broadcast",
  "version": "1.0.0-beta.2",
  "description": "broadcast voice control",
  "title": "broadcast",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./dist/style/style.css": "./dist/style/style.css",
    "./dist/style/style.js": "./dist/style/style.js",
    "./dist/style/style": "./dist/style/style.js",
    "./dist/style/index.js": "./dist/style/index.js",
    "./dist/style/index": "./dist/style/index.js",
    "./dist/style": "./dist/style/index.js"
  },
  "keywords": [
    "ezuikit",
    "broadcast",
    "voice"
  ],
  "author": "Ezviz-OpenBiz",
  "license": "",
  "dependencies": {
    "@ezuikit/control-drawer": "0.0.1",
    "@ezuikit/control-message": "0.0.1-beta.5",
    "@ezuikit/utils-i18n": "^2.0.1",
    "@ezuikit/utils-logger": "2.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ezviz-OpenBiz/EZUIKit-player-controls.git"
  },
  "bugs": {
    "url": "https://github.com/Ezviz-OpenBiz/EZUIKit-player-controls/issues"
  },
  "homepage": "https://github.com/Ezviz-OpenBiz/EZUIKit-player-controls#readme"
}
