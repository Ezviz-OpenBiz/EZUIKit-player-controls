{
  "name": "@ezuikit/control-rec-list-modal",
  "version": "0.0.1-beta.4",
  "description": "recording list modal control for ezviz",
  "title": "rec-list-modal",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./dist/style/style.css": "./dist/style/style.css",
    "./dist/style": "./dist/style/index.js",
    "./dist/style/index": "./dist/style/index.js",
    "./dist/style/index.js": "./dist/style/index.js",
    "./dist/style/style": "./dist/style/style.js",
    "./dist/style/style.js": "./dist/style/style.js",
    "./dist/style/index.scss": "./dist/style/index.scss"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development rollup --config rollup.config.mjs --watch",
    "build": "npm run clean && cross-env NODE_ENV=production rollup --config rollup.config.mjs",
    "clean": "rimraf dist",
    "types": "tsc src/index.ts --emitDeclarationOnly --declaration --declarationDir dist/types --esModuleInterop"
  },
  "keywords": [
    "ezuikit",
    "ezviz",
    "modal",
    "record",
    "rec",
    "list",
    "timeline"
  ],
  "files": [
    "dist"
  ],
  "author": "Ezviz-OpenBiz",
  "license": "MIT",
  "dependencies": {
    "deepmerge": "^4.3.1",
    "@ezuikit/utils-tools": "2.0.3",
    "@ezuikit/utils-i18n": "^2.0.0",
    "@ezuikit/control-modal": "0.0.1-beta.5",
    "@ezuikit/control-virtual-scroll": "0.0.1-beta.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ezviz-OpenBiz/EZUIKit-player-controls.git"
  },
  "bugs": {
    "url": "https://github.com/Ezviz-OpenBiz/EZUIKit-player-controls/issues"
  },
  "homepage": "https://github.com/Ezviz-OpenBiz/EZUIKit-player-controls#readme"
}
